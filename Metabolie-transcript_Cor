# Function: correlate one gene against all metabolites
correlate_gene_vs_metabolites <- function(gene, data, metab_cols) {
  
  gene_data <- data %>% filter(gene_ID == gene)
  
  if (nrow(gene_data) < 5) return(NULL)
  
  map_dfr(metab_cols, function(m) {
    
    df <- gene_data %>%
      select(expr = z.score.TPM, metab = all_of(m)) %>%
      filter(!is.na(metab), !is.na(expr))
    
    if (nrow(df) < 5) return(NULL)
    
    n  <- nrow(df)
    
    # Pearson
    r_p  <- cor(df$expr, df$metab, method = "pearson")
    t_p  <- r_p * sqrt((n - 2) / (1 - r_p^2))
    p_p  <- 2 * pt(-abs(t_p), df = n - 2)
    
    # Spearman (robustness check)
    r_s  <- cor(df$expr, df$metab, method = "spearman")
    t_s  <- r_s * sqrt((n - 2) / (1 - r_s^2))
    p_s  <- 2 * pt(-abs(t_s), df = n - 2)
    
    tibble(
      gene_ID         = gene,
      metabolite      = m,
      n               = n,
      r_pearson       = r_p,
      p_pearson       = p_p,
      r_spearman      = r_s,
      p_spearman      = p_s
    )
  })
}

# Run for all candidates
cat("\nRunning correlations...\n")

cor_results_raw <- map_dfr(
  candidate_gene_ids,
  ~correlate_gene_vs_metabolites(.x, expr_metab_joined, all_metab_cols),
  .progress = TRUE
)

# FDR correction per metabolite
cor_results <- cor_results_raw %>%
  group_by(metabolite) %>%
  mutate(
    FDR_pearson  = p.adjust(p_pearson,  method = "fdr"),
    FDR_spearman = p.adjust(p_spearman, method = "fdr")
  ) %>%
  ungroup()

# Assign metabolite tier
cor_results <- cor_results %>%
  mutate(
    metab_tier = case_when(
      metabolite %in% tier1_cols ~ "Tier1_primary",
      metabolite %in% tier2_cols ~ "Tier2_precursor",
      metabolite %in% tier3_cols ~ "Tier3_caution"
    )
  )

write_csv(cor_results,
          file.path(out_metab, "results", "all_candidate_metabolite_correlations.csv"))

cat("\nTotal gene-metabolite pairs tested:", nrow(cor_results), "\n")

# ================================================================
# 6) Filter significant hits
# ================================================================
r_thresh   <- 0.7
fdr_thresh <- 0.05

cor_sig <- cor_results %>%
  filter(
    abs(r_pearson) >= r_thresh,
    FDR_pearson    <  fdr_thresh
  )

cat("\nSignificant hits (|r| >=", r_thresh, ", FDR <", fdr_thresh, "):",
    nrow(cor_sig), "\n")
cat("Unique genes:", n_distinct(cor_sig$gene_ID), "\n")
cat("Breakdown by metabolite:\n")
print(count(cor_sig, metabolite, sort = TRUE))

# ================================================================
# 7) Join candidate metadata onto results
# ================================================================
candidate_meta <- new_candidates_ranked_filtered %>%
  select(gene_ID, module, Module_class,
         annotation_category, best_branch,
