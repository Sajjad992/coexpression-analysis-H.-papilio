# --- 9c) Scatter: top hits per metabolite ---
plot_top_scatter <- function(metab_name, top_n = 6) {
  
  top_g <- cor_sig_annot %>%
    filter(metabolite == metab_name) %>%
    slice_max(abs(r_pearson), n = top_n) %>%
    pull(gene_ID)
  
  if (length(top_g) == 0) return(NULL)
  
  plot_data <- expr_metab_joined %>%
    filter(gene_ID %in% top_g) %>%
    select(sample, tissue, gene_ID,
           z.score.TPM, metab_val = all_of(metab_name)) %>%
    filter(!is.na(metab_val)) %>%
    left_join(cor_sig_annot %>%
                filter(metabolite == metab_name) %>%
                select(gene_ID, r_pearson, FDR_pearson,
                       annotation_category),
              by = "gene_ID")
  
  ggplot(plot_data,
         aes(x = metab_val, y = z.score.TPM, color = tissue)) +
    geom_point(size = 2.5, alpha = 0.8) +
    geom_smooth(method = "lm", se = TRUE,
                color = "grey30", linewidth = 0.7) +
    geom_label(
      data = plot_data %>%
        distinct(gene_ID, r_pearson, FDR_pearson, annotation_category),
      aes(label = paste0("r=", round(r_pearson, 2),
                         "\nFDR=", signif(FDR_pearson, 2))),
      x = -Inf, y = Inf, hjust = -0.1, vjust = 1.2,
      size = 3, inherit.aes = FALSE, color = "black"
    ) +
    facet_wrap(~gene_ID, scales = "free", ncol = 3) +
    labs(
      title = paste("Top hits —", metab_name),
      x = paste(metab_name, "(ng/ml)"),
      y = "z-scored TPM",
      color = "Tissue"
    ) +
    theme_classic(base_size = 11) +
    theme(legend.position = "bottom")
}

# Save scatter plots for Tier 1 metabolites
