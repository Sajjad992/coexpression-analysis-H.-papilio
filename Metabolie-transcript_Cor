  "metabolites/metabolitesabsolute.xlsx",
  sheet = 1,
  na = c("", "NA", "n/a", "N/A", "nd", "ND", "-")
)

# Drop the spurious ...2 column and Norbelladine (all NA)
# Drop sparse metabolites (>75% missing): Ferulic acid, Dopamine, p-coumaric acid
metab_clean <- metab_raw %>%
  select(-any_of(c("...2", "Norbelladine",
                   "Ferulic acid", "Dopamine", "p-coumaric acid"))) %>%
  rename(sample = Tissue) %>%
  mutate(
    # Extract tissue name from sample ID (R_1 -> Root, BS_1 -> Basalplate etc.)
    tissue = case_when(
      str_starts(sample, "R_")   ~ "Root",
      str_starts(sample, "BS_")  ~ "Basalplate",
      str_starts(sample, "IB_")  ~ "Innerbulb",
      str_starts(sample, "YL_")  ~ "Youngleaf",
      str_starts(sample, "OL_")  ~ "Oldleaf",
      str_starts(sample, "FS_")  ~ "Flowerstalk",
      str_starts(sample, "P_")   ~ "Petal",
      str_starts(sample, "PD_")  ~ "Peduncle",
      str_starts(sample, "PI_")  ~ "Pistil",
      TRUE ~ sample
    )
  )

cat("Metabolite table after cleaning:", dim(metab_clean), "\n")
cat("Tissues represented:\n")
print(table(metab_clean$tissue))

# ================================================================
# 2) Compute derived metabolite variables
# ================================================================
metab_derived <- metab_clean %>%
  mutate(
    # Tier 1 ratios
    Gal_Hae_ratio     = Galanthamine / Haemanthamine,
    
    # Tier 2 — total precursor amino acid pool
    Total_AA          = `L-Tyrosine` + Phenylalanine,
    Tyr_Phe_ratio     = `L-Tyrosine` / Phenylalanine,
    
    # Tier 1 — galanthamine branch: norgalanthamine as intermediate
    Norgal_Gal_ratio  = Norgalanthamine / Galanthamine,
    
    # Tier 1 — haemanthamine branch proxy
    Vit_Hae_ratio     = `Vittatine and/or crinine` / Haemanthamine,
    
    # Total alkaloid load
    Total_alkaloid    = Galanthamine + Haemanthamine +
      Norgalanthamine +
      replace_na(`Vittatine and/or crinine`, 0)
  )

# Define which metabolite columns to use in correlation
# Tier 1 (complete / biologically central)
tier1_cols <- c(
  "Galanthamine", "Haemanthamine",
  "Gal_Hae_ratio", "Norgalanthamine",
  "Vittatine and/or crinine",
  "Total_alkaloid"
)

# Tier 2 (precursor pool)
tier2_cols <- c(
  "L-Tyrosine", "Phenylalanine",
  "Total_AA", "Tyr_Phe_ratio"
)

# Tier 3 (use with caution — partial missingness)
tier3_cols <- c(
  "4-hydroxybenzaldehyde",
  "4'-O-methylnorbelladine",
  "Tyramine", "Vanillin"
)

all_metab_cols <- c(tier1_cols, tier2_cols, tier3_cols)

cat("\nMetabolite columns for correlation:\n")
print(all_metab_cols)

# ================================================================
# 3) Z-score metabolites (for plotting only)
# ================================================================
