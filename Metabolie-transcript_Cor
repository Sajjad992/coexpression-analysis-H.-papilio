# --- 9b) Heatmap: top genes x Tier 1 metabolites ---
top_genes <- cor_sig_annot %>%
  filter(metab_tier == "Tier1_primary") %>%
  group_by(gene_ID) %>%
  summarise(max_abs_r = max(abs(r_pearson)), .groups = "drop") %>%
  slice_max(max_abs_r, n = 60) %>%
  pull(gene_ID)

heatmap_mat <- cor_results %>%
  filter(gene_ID %in% top_genes,
         metabolite %in% tier1_cols) %>%
  select(gene_ID, metabolite, r_pearson) %>%
  pivot_wider(names_from = metabolite, values_from = r_pearson) %>%
  column_to_rownames("gene_ID")

# Add significance asterisks
sig_mat <- cor_results %>%
  filter(gene_ID %in% top_genes,
         metabolite %in% tier1_cols) %>%
  select(gene_ID, metabolite, FDR_pearson) %>%
  pivot_wider(names_from = metabolite, values_from = FDR_pearson) %>%
  column_to_rownames("gene_ID")

heatmap_long <- heatmap_mat %>%
  rownames_to_column("gene_ID") %>%
  pivot_longer(-gene_ID, names_to = "metabolite", values_to = "r") %>%
  left_join(
    sig_mat %>%
      rownames_to_column("gene_ID") %>%
      pivot_longer(-gene_ID, names_to = "metabolite", values_to = "FDR"),
