         Pfam_desc, EggNM.Description,
         Gal_score, Hae_score, TotalAA_score, Bio_score,
         mean_r_Galanthamine, mean_r_Haemanthamine, mean_r_Precursor)

cor_sig_annot <- cor_sig %>%
  left_join(candidate_meta, by = "gene_ID") %>%
  arrange(metabolite, desc(abs(r_pearson)))

write_csv(cor_sig_annot,
