# -------------------------------
# 5️⃣ Helper: correlation against bait set
# -------------------------------
correlate_against_bait_set <- function(bait_ids, bait_label, expr_wide, r_cutoff = 0.9, fdr_cutoff = 0.01) {
  
  bait_ids <- intersect(bait_ids, expr_wide$gene_ID)
  
  if (length(bait_ids) == 0) {
    warning("No bait IDs found in expression matrix for: ", bait_label)
    return(NULL)
  }
  
  res <- lapply(bait_ids, function(x) {
    bait_row <- expr_wide %>% filter(gene_ID == x)
    other_rows <- expr_wide %>% filter(gene_ID != x)
    
    dBait <- t(as.matrix(bait_row[, -1, drop = FALSE]))
    dOthers <- t(as.matrix(other_rows[, -1, drop = FALSE]))
    
    data.frame(correlation = cor(dBait, dOthers) %>% t) %>%
      mutate(
        Gene1 = x,
        Gene2 = other_rows$gene_ID,
        BaitSet = bait_label,
        r2 = correlation^2,
        t_vals = ifelse(abs(correlation) == 1, Inf,
                        correlation * sqrt(n_samples - 2) / sqrt(1 - r2)),
        p_vals = ifelse(abs(correlation) == 1, 0,
                        2 * pt(-abs(t_vals), df = n_samples - 2))
      )
  }) %>% list_rbind()
  
  res <- res %>%
    mutate(
      fdr_vals = p.adjust(p_vals, method = "fdr"),
      significant = fdr_vals < fdr_cutoff
    )
  
  return(res)
}

