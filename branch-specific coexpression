# 9️⃣ Summarize gene-level branch scores
# -------------------------------
gene_branch_scores <- cor_branch_all %>%
  filter(significant, correlation >= r_cutoff) %>%
  group_by(BaitSet, Gene2) %>%
  summarise(
    mean_r = mean(correlation, na.rm = TRUE),
    max_r = max(correlation, na.rm = TRUE),
    n_baits = n_distinct(Gene1),
    .groups = "drop"
  ) %>%
  pivot_wider(
    names_from = BaitSet,
    values_from = c(mean_r, max_r, n_baits),
    values_fill = 0
  ) %>%
  rename(gene_ID = Gene2)

write_tsv(gene_branch_scores, file.path(out_tables, "gene_branch_scores.tsv"))

# -------------------------------
# 🔟 Keep genes strongly correlated with any bait set
# -------------------------------
genes_to_keep <- cor_branch_all %>%
  filter(significant, correlation >= r_cutoff) %>%
  pull(Gene2) %>%
  unique()

genes_to_keep <- union(genes_to_keep, unique(bait_info$gene_ID))

cat("Genes retained for branch-guided network:", length(genes_to_keep), "\n")

write_tsv(
