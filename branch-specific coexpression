module_class_scores <- heatmap_data %>%
  group_by(module, TissueClass) %>%
  summarise(mean_class_z = mean(mean.z, na.rm = TRUE), .groups = "drop") %>%
  pivot_wider(names_from = TissueClass, values_from = mean_class_z, values_fill = 0) %>%
  mutate(
    Gal_score = `High Gal` - pmax(`High Hae`, Other, na.rm = TRUE),
    Hae_score = `High Hae` - pmax(`High Gal`, Other, na.rm = TRUE),
    TotalAA_score = `High Total AA`,
    Bio_score = `Biosynth Active`,
    Module_class = case_when(
      Gal_score >= 0.5 & `High Gal` > `High Hae` ~ "Galanthamine-like",
      Hae_score >= 0.5 & `High Hae` > `High Gal` ~ "Haemanthamine-like",
      TotalAA_score >= 0.5 ~ "High Total AA / shared",
      Bio_score >= 0.5 ~ "Biosynthetically active",
      TRUE ~ "Other"
    )
  )

write_tsv(module_class_scores, file.path(out_tables, "module_class_scores.tsv"))
module_class_scores %>%
  select(module, `High Gal`, `High Hae`, `High Total AA`, `Biosynth Active`,
