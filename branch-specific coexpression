# 11️⃣ Build filtered expression matrix
# -------------------------------
Expr_filtered_long <- Exp_table_long_averaged_z_cp %>%
  filter(gene_ID %in% genes_to_keep)

Expr_filtered_wide <- Expr_filtered_long %>%
  select(gene_ID, !!sym(sample_col), z.score.TPM) %>%
  pivot_wider(names_from = !!sym(sample_col), values_from = z.score.TPM) %>%
  column_to_rownames("gene_ID")

if (nrow(Expr_filtered_wide) < 2) {
  stop("Not enough genes retained to compute all-vs-all correlations.")
}

# -------------------------------
# 12️⃣ All-vs-all correlation matrix
# -------------------------------
cor_mat <- cor(
  t(Expr_filtered_wide),
  use = "pairwise.complete.obs",
  method = "pearson"
)

cor_long <- as.data.frame(cor_mat) %>%
  tibble::rownames_to_column("Gene1") %>%
  pivot_longer(-Gene1, names_to = "Gene2", values_to = "correlation") %>%
  filter(Gene1 != Gene2) %>%
  mutate(
    t_stat = ifelse(abs(correlation) == 1, Inf,
                    correlation * sqrt((n_samples - 2) / (1 - correlation^2))),
    p_value = ifelse(abs(correlation) == 1, 0,
                     2 * pt(-abs(t_stat), df = n_samples - 2)),
    FDR = p.adjust(p_value, method = "fdr"),
    significant = FDR < fdr_cutoff
  )

cor_long_filtered_unique <- cor_long %>%
  filter(significant, abs(correlation) >= r_cutoff) %>%
  mutate(pair = paste0(pmin(Gene1, Gene2), "_", pmax(Gene1, Gene2))) %>%
  distinct(pair, .keep_all = TRUE) %>%
  select(-pair)

write_tsv(
  cor_long_filtered_unique,
  file.path(out_res, "branch_guided_all_vs_all_correlations_filtered.tsv")
)

# -------------------------------
# 13️⃣ Build network
# -------------------------------
edge_table <- cor_long_filtered_unique %>%
  rename(from = Gene1, to = Gene2, weight = correlation) %>%
  select(from, to, weight, p_value, FDR)

node_table <- tibble(gene_ID = unique(c(edge_table$from, edge_table$to)))

my_network <- graph_from_data_frame(
  edge_table,
  vertices = node_table,
  directed = FALSE
)

cat("Network built:", vcount(my_network), "nodes,", ecount(my_network), "edges\n")

saveRDS(my_network, file = file.path(out_res, "branch_guided_network.rds"))
write_tsv(edge_table, file.path(out_res, "branch_guided_network_edges.tsv"))

# -------------------------------
# 14️⃣ Leiden modules
# -------------------------------
if (!exists("optimize_resolution")) {
  warning("optimize_resolution() not found. Using resolution = 1.")
  resolution <- 1
} else {
  future::plan(multisession, workers = 1)
  
  res_seq <- seq(0.25, 5, by = 0.25)
  opt_res_df <- future_map_dfr(
    res_seq,
    ~{
      res_out <- optimize_resolution(
        network = my_network,
        resolution = .x,
        minGenes = minGenes
      )
      data.frame(
        resolution = .x,
        num_module = as.numeric(res_out[1]),
        num_contained_gene = as.numeric(res_out[2])
      )
    },
    .options = furrr_options(seed = TRUE)
  )
  
  write_tsv(opt_res_df, file.path(out_tables, "leiden_resolution_scan.tsv"))
  
  best_row <- opt_res_df %>%
    filter(num_contained_gene == max(num_contained_gene, na.rm = TRUE)) %>%
    slice_tail(n = 1)
  
  resolution <- best_row$resolution
}

cat("Selected Leiden resolution:", resolution, "\n")

modules_ <- cluster_leiden(
  my_network,
  resolution_parameter = resolution,
  objective_function = "modularity"
)

my_network_modules <- tibble(
  gene_ID = names(membership(modules_)),
  module = as.integer(membership(modules_))
) %>%
  inner_join(node_table, by = "gene_ID") %>%
  group_by(module) %>%
  filter(n() >= minGenes) %>%
  ungroup()

write_tsv(
  my_network_modules,
  file.path(out_res, "branch_guided_network_modules.tsv")
)

cat("Modules detected after filtering:", n_distinct(my_network_modules$module), "\n")

