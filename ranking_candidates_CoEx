# ----------------------------------------------------------------
# 4) Semantic Pfam category patterns
#    Broad regex on descriptions — catches all family variants
# ----------------------------------------------------------------
pat_biosynthetic <- regex(paste(
  "methyltransfer", "cytochrome P450", "\\bCYP\\b",
  "reductase", "oxidase", "oxidoreductase", "dehydrogenase",
  "hydroxylase", "synthase", "synthetase", "lyase", "ligase",
  "transferase", "acetylase", "acyltransfer",
  "glucosyltransfer", "glycosyltransfer",
  "carboxylase", "isomerase", "decarboxylase", "epimerase",
  "monooxygenase", "dioxygenase", "peroxidase",
  sep = "|"), ignore_case = TRUE)

pat_transporter <- regex(paste(
  "transport", "permease", "carrier", "channel", "efflux",
  "importer", "exporter", "\\bABC\\b", "\\bMATE\\b", "\\bMFS\\b",
  "\\bNPF\\b", "\\bSWEET\\b", "\\bPOT\\b", "\\bNRT\\b",
  "major facilitator", "drug resistance",
  sep = "|"), ignore_case = TRUE)

pat_tf <- regex(paste(
  "WRKY", "\\bMYB\\b", "bHLH", "\\bAP2\\b", "\\bERF\\b",
  "\\bNAC\\b", "\\bGRAS\\b", "\\bMADS\\b", "\\bBZIP\\b",
  "\\bLBD\\b", "\\bARF\\b", "homeodomain", "zinc finger",
  "\\bC2H2\\b", "\\bDOF\\b", "\\bTCP\\b", "\\bGRF\\b",
  "transcription factor", "transcriptional regul",
  sep = "|"), ignore_case = TRUE)

pat_regulatory <- regex(paste(
  "kinase", "phosphatase", "ubiquitin", "protease",
  "receptor", "signal", "response regul",
  sep = "|"), ignore_case = TRUE)

# ----------------------------------------------------------------
# 5) Priority scoring
# ----------------------------------------------------------------
new_candidates_ranked <- new_candidates_annot %>%
  mutate(
    desc_combined = paste(
      replace_na(Pfam_desc, ""),
      replace_na(EggNM.Description, ""),
      replace_na(sprot_Top_BLASTP_hit, ""),
      sep = " "
    ),
    
    is_biosynthetic = str_detect(desc_combined, pat_biosynthetic),
    is_transporter  = str_detect(desc_combined, pat_transporter),
    is_tf           = str_detect(desc_combined, pat_tf),
    is_regulatory   = str_detect(desc_combined, pat_regulatory),
    
    across(starts_with("is_"), ~replace_na(.x, FALSE)),
    
    module_priority = case_when(
      module %in% c(1, 5) ~ 3,
      module %in% c(2, 4) ~ 2,
      TRUE                ~ 1
    ),
    
    class_priority = case_when(
      Module_class == "High Total AA / shared"  ~ 3,
      Module_class == "Biosynthetically active" ~ 3,
      Module_class == "Galanthamine-like"        ~ 2,
      Module_class == "Haemanthamine-like"       ~ 2,
      TRUE                                       ~ 1
    ),
    
    annotation_priority = case_when(
      is_biosynthetic          ~ 3,
      is_transporter | is_tf   ~ 2,
      is_regulatory            ~ 1,
      TRUE                     ~ 0
    ),
    
    annotation_category = case_when(
      is_biosynthetic   ~ "biosynthetic enzyme",
      is_transporter    ~ "transporter",
      is_tf             ~ "transcription factor",
      is_regulatory     ~ "regulatory",
      !is.na(Pfam_desc) ~ "other annotated",
      TRUE              ~ "no Pfam"
    ),
    
    across(starts_with("mean_r_"), ~replace_na(.x, 0)),
    across(starts_with("max_r_"),  ~replace_na(.x, 0)),
    across(starts_with("n_baits"), ~replace_na(.x, 0L)),
    
    final_priority = module_priority + class_priority + annotation_priority
    
  ) %>%                              # ← mutate ends here
  
  # ---- REPLACES the old distinct + arrange ----
distinct(gene_ID, .keep_all = TRUE) %>%
  mutate(
    best_branch_r = pmax(mean_r_Galanthamine, mean_r_Haemanthamine, mean_r_Precursor, na.rm = TRUE),
    
    best_branch = case_when(
      best_branch_r == mean_r_Galanthamine  ~ "Galanthamine",
      best_branch_r == mean_r_Haemanthamine ~ "Haemanthamine",
      best_branch_r == mean_r_Precursor     ~ "Precursor",
      TRUE                                  ~ "none"
    ),
    
    best_branch_n_baits = case_when(
      best_branch == "Galanthamine"  ~ n_baits_Galanthamine,
      best_branch == "Haemanthamine" ~ n_baits_Haemanthamine,
      best_branch == "Precursor"     ~ n_baits_Precursor,
      TRUE                           ~ 0L
    )
  ) %>%
  arrange(
    desc(final_priority),
    desc(best_branch_r),
    desc(best_branch_n_baits)
  )
