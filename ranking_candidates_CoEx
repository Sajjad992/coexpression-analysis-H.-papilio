# ----------------------------------------------------------------
# Audit protein lengths BEFORE deciding thresholds
# ----------------------------------------------------------------
new_candidates_ranked %>%
  group_by(annotation_category) %>%
  summarise(
    n_total     = n(),
    n_no_length = sum(is.na(protein_length)),
    n_under_100 = sum(protein_length < 100,  na.rm = TRUE),
    n_under_200 = sum(protein_length < 200,  na.rm = TRUE),
    n_under_300 = sum(protein_length < 300,  na.rm = TRUE),
    n_under_400 = sum(protein_length < 400,  na.rm = TRUE),
    median_len  = median(protein_length,     na.rm = TRUE),
    min_len     = min(protein_length,        na.rm = TRUE),
    max_len     = max(protein_length,        na.rm = TRUE),
    .groups = "drop"
  ) %>%
  print(width = Inf)

# ----------------------------------------------------------------
# Apply category-specific length thresholds
# ----------------------------------------------------------------
new_candidates_ranked <- new_candidates_ranked %>%
  mutate(
    length_threshold = case_when(
      annotation_category == "biosynthetic enzyme"  ~ 250L,
      annotation_category == "transporter"          ~ 300L,
      annotation_category == "transcription factor" ~ 150L,
      annotation_category == "regulatory"           ~ 150L,
      annotation_category == "other annotated"      ~ 100L,
      annotation_category == "no Pfam"              ~ 150L,
      TRUE                                          ~ 100L
    ),
    passes_length = case_when(
      is.na(protein_length)              ~ FALSE,
      protein_length >= length_threshold ~ TRUE,
      TRUE                               ~ FALSE
    ),
    length_flag = case_when(
      is.na(protein_length) ~ "no sequence",
      !passes_length        ~ paste0("too short (",
                                     protein_length, " aa < ",
                                     length_threshold, " threshold)"),
      TRUE                  ~ "pass"
    )
  )

# ----------------------------------------------------------------
# Report what gets removed per category
# ----------------------------------------------------------------
cat("\nLength filter summary:\n")
new_candidates_ranked %>%
  count(annotation_category, passes_length) %>%
  pivot_wider(names_from = passes_length,
              values_from = n,
              values_fill = 0) %>%
  rename(passes = `TRUE`, removed = `FALSE`) %>%
  mutate(pct_kept = round(100 * passes / (passes + removed), 1)) %>%
  print()

# ----------------------------------------------------------------
# Split into passing and flagged
# ----------------------------------------------------------------
new_candidates_ranked_filtered <- new_candidates_ranked %>%
  filter(passes_length)

new_candidates_ranked_tooshort <- new_candidates_ranked %>%
  filter(!passes_length)

cat("\nTotal before filter:", nrow(new_candidates_ranked), "\n")
cat("Passes length filter:", nrow(new_candidates_ranked_filtered), "\n")
cat("Removed as too short:", nrow(new_candidates_ranked_tooshort), "\n")

