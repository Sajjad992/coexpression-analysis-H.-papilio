library(tidyverse)
colnames(trinotate)

# ----------------------------------------------------------------
# 1) Pfam description lookup from Trinotate
#    Handles both backtick and caret delimiters
# ----------------------------------------------------------------
pfam_description_lookup <- trinotate %>%
  select(gene_id = `#gene_id`, Pfam) %>%
  filter(!is.na(Pfam), Pfam != ".") %>%
  separate_rows(Pfam, sep = "`") %>%
  mutate(
    Pfam_ID   = str_extract(Pfam, "PF\\d+"),
    Pfam_desc = str_extract(Pfam, "(?<=[`\\^])[^`\\^]+(?=[`\\^])")
  ) %>%
  filter(!is.na(Pfam_ID)) %>%
  distinct(gene_id, Pfam_ID, Pfam_desc)

# Collapse to one row per gene
pfam_per_gene <- pfam_description_lookup %>%
  group_by(gene_id) %>%
  summarise(
    Pfam_IDs  = paste(unique(Pfam_ID),   collapse = ";"),
    Pfam_desc = paste(unique(na.omit(Pfam_desc)), collapse = ";"),
    .groups = "drop"
  )

cat("Genes with Pfam annotation:", nrow(pfam_per_gene), "\n")

# ----------------------------------------------------------------
# 2) Build candidate base table
#    Exclude known baits, keep modules of interest
# ----------------------------------------------------------------
new_candidates <- my_network_modules_annotated %>%
  filter(module %in% c(1, 2, 4, 5)) %>%
  filter(!gene_ID %in% bait_info$gene_ID)

cat("New candidates (non-bait, modules 1/2/4/5):", nrow(new_candidates), "\n")
colnames(new_candidates)
# ----------------------------------------------------------------
# 3) Join Pfam + Trinotate annotation
#    Clean up any duplicate columns from prior joins
# ----------------------------------------------------------------
# ----------------------------------------------------------------
# 3) Join Pfam + Trinotate annotation — CORRECTED
# add peptide, transcript, prot_coords to existing join
# ----------------------------------------------------------------
new_candidates_annot <- new_candidates %>%
  select(-any_of(c("Pfam", "Pfam_IDs", "Pfam_desc",
                   "module.y", "Module_class.y",
                   "Gal_score.y", "Hae_score.y",
                   "TotalAA_score.y", "Bio_score.y"))) %>%
  rename_with(~str_remove(.x, "\\.x$")) %>%
  left_join(pfam_per_gene, by = c("gene_ID" = "gene_id")) %>%
  left_join(
    trinotate %>%
      select(gene_id = `#gene_id`,
             EggNM.Description,
             sprot_Top_BLASTP_hit,
             gene_ontology_Pfam,
             prot_coords,        # ← added
             peptide,            # ← added
             transcript          # ← added
      ) %>%
      mutate(
        protein_length    = if_else(
          !is.na(peptide) & peptide != ".",
          nchar(peptide), NA_integer_),
        transcript_length = if_else(
          !is.na(transcript) & transcript != ".",
          nchar(transcript), NA_integer_)
      ) %>%
      group_by(gene_id) %>%
      slice_max(protein_length, n = 1,
                with_ties = FALSE) %>%
      ungroup() %>%
      distinct(gene_id, .keep_all = TRUE),
    by = c("gene_ID" = "gene_id")
  )
cat("Candidates after annotation join:", nrow(new_candidates_annot), "\n")
cat("Unique candidates:", n_distinct(new_candidates_annot$gene_ID), "\n")
